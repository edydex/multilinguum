NODE_ENV=development
PROCESSOR_HOST=127.0.0.1
PROCESSOR_PORT=4310
PROCESSOR_PUBLIC_URL=http://127.0.0.1:4310
PROCESSOR_CONTROL_TOKEN=replace-with-at-least-32-random-characters
OPERATOR_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420
ARCHIVE_ROOT=./data/archives
ARCHIVE_RETENTION_DAYS=30
SERVICE_BUDGET_WARNING_USD=20
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_FILE_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-terra
# Managed Community / SyncShow profiles. OPENAI_API_KEY is the separate audio key.
OPENAI_QUALITY_TEXT_API_KEY=
OPENAI_QUALITY_TEXT_MODEL=gpt-6-astra
OPENAI_QUALITY_REASONING_EFFORT=low
OPENAI_ECONOMY_TEXT_API_KEY=
OPENAI_ECONOMY_TEXT_MODEL=gpt-5.6-terra
OPENAI_ECONOMY_REASONING_EFFORT=none
# Check sharing/eligibility in the text project's OpenAI settings first.
# This application never changes account sharing and cannot verify remaining allowance.
OPENAI_ECONOMY_SHARING_CONFIRMED=false
# block refuses Economy. allow-billed accepts charges when allowance is unavailable.
OPENAI_ECONOMY_OVERAGE_POLICY=block
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CLOUDFLARE_PUBLIC_ORIGIN=http://localhost:4173
# Optional cloned voice only: set http://voice-worker:4320 and use --profile cloned-voice.
VOICE_WORKER_URL=
VOICE_WORKER_TOKEN=replace-with-a-separate-random-worker-token
VOICE_PROFILE_KEY=
